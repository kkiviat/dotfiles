# History
HISTFILE=~/.zsh_history
HISTSIZE=10000
SAVEHIST=10000
setopt SHARE_HISTORY
setopt HIST_IGNORE_DUPS          # Do not record an event that was just recorded again.
setopt EXTENDED_HISTORY          # Write the history file in the ':start:elapsed;command' format.
setopt HIST_EXPIRE_DUPS_FIRST    # Expire a duplicate event first when trimming history.

autoload -Uz compinit && compinit
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Z}'

autoload -Uz select-word-style
select-word-style bash

# aliases
alias l='ls'
alias ll='ls -l'
alias la='ls -lA'

bindkey "^[[3~" delete-char

export EDITOR="nvim"
export VISUAl="$EDITOR"
set -o emacs

export PATH="$PATH:/opt/nvim-linux-x86_64/bin:$HOME/.local/bin"

# Load the built-in vcs_info module
autoload -Uz vcs_info

# Run vcs_info before each prompt
precmd() { vcs_info }

# Enable git and show branch + staged/unstaged markers
zstyle ':vcs_info:git:*' formats ' (%b%u%c)'
zstyle ':vcs_info:git:*' actionformats ' (%b|%a%u%c)'
zstyle ':vcs_info:*' enable git
zstyle ':vcs_info:git:*' check-for-changes true
zstyle ':vcs_info:git:*' unstagedstr ' !'   # shown when there are unstaged changes
zstyle ':vcs_info:git:*' stagedstr ' +'     # shown when there are staged changes

# Allow substitutions in the prompt
setopt PROMPT_SUBST

# Build the prompt
PROMPT='%F{green}[%D{%H:%M:%S}]%f %F{pink}%n%f@%F{yellow}%m%f %F{cyan}%~%f%F{yellow}${vcs_info_msg_0_}%f
%F{magenta}❯%f '

# Ensure the line editor is in the right mode
autoload -Uz up-line-or-beginning-search
autoload -Uz down-line-or-beginning-search
zle -N up-line-or-beginning-search
zle -N down-line-or-beginning-search

# Bind to Arrow Keys (using terminfo for better compatibility)
[[ -n "${terminfo[kcuu1]}" ]] && bindkey "${terminfo[kcuu1]}" up-line-or-beginning-search
[[ -n "${terminfo[kcud1]}" ]] && bindkey "${terminfo[kcud1]}" down-line-or-beginning-search

# Fallback for some terminals that don't communicate terminfo perfectly
bindkey "\e[A" up-line-or-beginning-search
bindkey "\e[B" down-line-or-beginning-search

# bind home and end keys
bindkey "^[[H" beginning-of-line
bindkey "^[[F" end-of-line

# fzf
export FZF_DEFAULT_COMMAND='rg --files --hidden --smart-case'

claude-sandbox() {
  docker run -it --rm \
      -v "$(pwd):/workspace" \
      -v claude-config:/home/dev/.claude \
      -v "$HOME/.claude.json:/home/dev/.claude.json" \
      -w /workspace \
      -p 8000:8000 \
      -p 61537:61537 \
      my-claude zsh
}
